; Engine configuration file. Godot 4.7.2-stable is pinned in tools/env.sh.
config_version=5

[application]
config/name="Arena Godot Client"
run/main_scene="res://scenes/smoke/capture_smoke.tscn"

[autoload]

; Registered by hand (the addon plugin would do it on enable in the editor) so the camera_spike
; prototype runs headless and under capture.sh. Remove with the prototype if it is not adopted.
PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720

[editor_plugins]
enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[physics]
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
