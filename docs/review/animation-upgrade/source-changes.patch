+import fs from 'node:fs/promises';
+import { chromium } from 'playwright';
+import { browserLaunchOptions } from './qa-server.mjs';
+const label = process.argv[2] ?? 'baseline';
+const root = `work/qa/animation-upgrade/${label}`;
